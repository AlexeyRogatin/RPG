{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "lib": [
      "ES2016",
      "DOM",
    ],
    "module": "system",
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "rootDir": "code",
    "outDir": "build",
    "outFile": "build/index.js",
  },
  "include": [
    "code/*.ts"
  ]
}